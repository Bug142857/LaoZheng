{
  "name": "laozheng-pc",
  "version": "0.292.0",
  "private": true,
  "description": "老郑分享 PC 端（Electron + React）",
  "author": "老郑",
  "license": "MIT",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "seed:sync": "node scripts/sync-seed-from-app.cjs",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "dist": "npm run build && electron-builder --win --publish never && node scripts/pack-artifact.cjs"
  },
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "adm-zip": "^0.6.1",
    "artplayer": "^5.4.0",
    "danmaku": "^2.0.10",
    "hls.js": "^1.7.3",
    "iconv-lite": "^0.6.3",
    "lucide-react": "^0.469.0",
    "mpegts.js": "^1.8.2",
    "node-html-parser": "^6.1.13",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "undici": "^7.30.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^45.4.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.73.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.9"
  },
  "build": {
    "appId": "com.laozheng.pc",
    "productName": "老郑分享",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "!node_modules/hls.js/**",
      "!node_modules/lucide-react/**",
      "!node_modules/react/**",
      "!node_modules/react-dom/**",
      "!node_modules/mpegts.js/**",
      "!node_modules/artplayer/**",
      "!node_modules/danmaku/**"
    ],
    "electronLanguages": [
      "zh-CN",
      "zh-TW",
      "en-US",
      "en-GB",
      "ja",
      "ko"
    ],
    "compression": "maximum",
    "extraResources": [
      {
        "from": ".secrets/accounts.json",
        "to": "accounts.seed.json"
      },
      {
        "from": "resources/default-seed.json",
        "to": "default-seed.json"
      },
      {
        "from": "resources/magnet-filter-words.txt",
        "to": "magnet-filter-words.txt"
      },
      {
        "from": "resources/tray.png",
        "to": "tray.png"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "老郑分享",
      "include": "installer.nsh"
    }
  }
}
